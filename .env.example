# ─────────────────────────────────────────────────────────────
# MarketFit 환경변수 예시
#   cp .env.example .env.local   (로컬 개발)
#   Vercel: Project → Settings → Environment Variables 에 같은 이름으로 등록
#
# 모든 외부 연동 값은 선택 사항입니다. 비워두면 Mock(데모) 모드로 전체 서비스가 동작합니다.
# Kakao / Gemini 키는 배포 후 /admin/integrations 화면에서 입력해도 됩니다.
# (환경변수에 값이 있으면 환경변수가 항상 우선합니다)
# ─────────────────────────────────────────────────────────────

# 배포 주소 (선택) — 예: https://marketfit-xxxx.vercel.app
# 공유 미리보기(OG) 주소 계산에 사용합니다. 비우면 요청 주소를 자동으로 사용합니다(하드코딩하지 않음).
APP_URL=

# 관리자 화면 비밀번호 (배포 환경에서는 필수, 8자 이상)
# 로컬 개발(npm run dev)에서는 비워두면 비밀번호 없이 /admin 에 들어갈 수 있습니다.
ADMIN_PASSWORD=

# 세션 서명·설정 암호화 키 (배포 환경 권장, 32자 이상 임의 문자열)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 이 값을 바꾸면 관리자 화면에서 저장한 연동 키를 다시 입력해야 합니다.
APP_SECRET=

# ── Gemini (서버 전용) ─────────────────────────────────────────
GEMINI_API_KEY=
# 비우면 gemini-flash-latest (최신 Flash 별칭) 사용
GEMINI_MODEL=

# ── Kakao ─────────────────────────────────────────────────────
# JavaScript 키: 브라우저 지도용 공개 키 (Kakao 콘솔의 JavaScript SDK 도메인에 사이트 주소 등록 필요)
NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API 키: 주소 → 좌표 변환(Kakao Local), 서버 전용
KAKAO_REST_API_KEY=

# ── Supabase (서버 전용, 선택) ─────────────────────────────────
# 설정하면 사용자 취향·행동·연동 설정이 영구 저장됩니다. 비우면 로컬 파일(.data) 또는 메모리 저장소 사용.
# service_role 키는 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=
# anon 키: 브라우저에 노출돼도 되는 공개 키 (RLS 정책으로 보호). 서버에서 읽기 전용 조회에 사용합니다.
SUPABASE_ANON_KEY=
# service_role 키: 모든 데이터에 접근 가능 — 서버 전용, 절대 클라이언트로 내보내지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 파일 저장소 경로 (선택, 기본 ./.data)
MARKETFIT_DATA_DIR=

# (선택) HTTPS가 아닌 사내망 IP로 npm run start 테스트할 때만 false. 배포 환경에서는 설정하지 마세요.
COOKIE_SECURE=

# (선택) nginx 등 리버스 프록시 뒤에서 직접 운영할 때만 true — X-Forwarded-For/X-Real-IP로 요청 한도를 계산합니다.
# Vercel은 자동으로 신뢰합니다. 프록시 없이 true로 두면 IP 위조로 요청 한도를 우회할 수 있습니다.
TRUST_PROXY=
